{"v":1,"k":"kj9","n":"漢検9級","p":80,"s":[["読み ①","yomi",[["[夏]休みに 海へ 行く。",["なつ","ふゆ","はる","あき"],"「夏」は「なつ」。音読みは「カ」です。"],["白い [雲]が ながれて いく。",["くも","あめ","ゆき","そら"],"「雲」は「くも」。"],["[朝]ごはんを 食べる。",["あさ","ひる","よる","ゆう"],"「朝」は「あさ」。音読みは「チョウ」です。"],["[雪]が つもった。",["ゆき","あめ","こおり","しも"],"「雪」は「ゆき」。"],["大きな [声]で 本を 読む。",["こえ","おと","うた","こと"],"「声」は「こえ」。"],["[弟]と 公園で あそぶ。",["おとうと","あに","いもうと","あね"],"「弟」は「おとうと」。"],["川で [魚]を つる。",["さかな","かい","とり","えび"],"「魚」は「さかな」。"],["夜空に [星]が 光る。",["ほし","つき","ひ","そら"],"「星」は「ほし」。"],["[黄]色い ぼうしを かぶる。",["き","こう","おう","あか"],"「黄色」は「きいろ」とよみます。"],["[牛]にゅうを のむ。",["ぎゅう","うし","ご","ぎょう"],"「牛」は「うし」ですが、「牛にゅう」では「ぎゅう」とよみます。"]]],["読み ②","yomi",[["[算数]の しゅくだいを する。",["さんすう","さんず","ざんすう","さんしゅう"],"「算」は「サン」、「数」は「スウ(かず)」。"],["[図書]室で 本を かりる。",["としょ","ずしょ","とかき","ずかき"],"「図」は「ズ・ト」。「図書」では「と」とよみます。"],["おばあちゃんに [電話]を かける。",["でんわ","でんはなし","てんわ","でんか"],"「電」は「デン」、「話」は「ワ(はなし)」。"],["[毎日] 日記を 書く。",["まいにち","まいび","ごとにち","まいひ"],"「毎」は「マイ」。"],["しんかんせんで [東京]に 行く。",["とうきょう","ひがしきょう","とうけい","とうきょ"],"「東」は「トウ(ひがし)」、「京」は「キョウ」。"],["[音楽]の じゅぎょうで うたう。",["おんがく","おんらく","いんがく","おとがく"],"「楽」は「ガク・ラク(たの-しい)」。"],["[生活]科で 野さいを そだてる。",["せいかつ","しょうかつ","せいがつ","いきかつ"],"「活」は「カツ」。"],["[午後]から 雨が ふる。",["ごご","ごうご","ごあと","うまご"],"「午」は「ゴ」、「後」は「ゴ・コウ(あと・うし-ろ)」。"],["[汽車]に のって 遠くへ 行く。",["きしゃ","きくるま","きじゃ","ぎしゃ"],"「車」は「シャ(くるま)」。"],["[交番]で 道を 聞く。",["こうばん","こうはん","ごうばん","こうぱん"],"「交」は「コウ」、「番」は「バン」。"]]],["書き取り ①","kaki",[["[あさ]、早く おきる。",["朝","昼","夜","明"],"「あさ」は「朝」。"],["[ひる]ごはんを 食べる。",["昼","朝","夜","星"],"「ひる」は「昼」。"],["[よる]に なると しずかに なる。",["夜","昼","朝","夕"],"「よる」は「夜」。"],["[はる]に 花が さく。",["春","夏","秋","冬"],"「はる」は「春」。"],["[あき]の 空は 高い。",["秋","春","冬","科"],"「あき」は「秋」。"],["[ふゆ]休みに スキーを する。",["冬","夏","秋","名"],"「ふゆ」は「冬」。"],["学校から [いえ]に かえる。",["家","室","字","空"],"「いえ」は「家」。"],["[ふね]で しまへ わたる。",["船","線","紙","組"],"「ふね」は「船」。"],["[みち]の はしを あるく。",["道","通","遠","近"],"「みち」は「道」。"],["[そと]で あそぶ。",["外","内","名","多"],"「そと」は「外」。"]]],["書き取り ②","kaki",[["あさ、[かお]を あらう。",["顔","頭","首","毛"],"「かお」は「顔」。"],["かぜで [あたま]が いたい。",["頭","顔","首","体"],"「あたま」は「頭」。"],["空を [とり]が とぶ。",["鳥","馬","魚","鳴"],"「とり」は「鳥」。"],["ぼくじょうで [うま]に のる。",["馬","鳥","牛","午"],"「うま」は「馬」。"],["[かみ]ひこうきを とばす。",["紙","組","線","細"],"「かみ」は「紙」。"],["画用紙に [え]を かく。",["絵","画","会","回"],"「え」は「絵」。"],["[ちゃ]色の 犬を かう。",["茶","草","花","算"],"「ちゃ」は「茶」。"],["[こころ]を こめて 手紙を 書く。",["心","思","新","小"],"「こころ」は「心」。"],["[あね]と 買いものに 行く。",["姉","妹","母","兄"],"「あね」は「姉」。「妹」は「いもうと」です。"],["[とも]だちと 話す。",["友","方","万","才"],"「とも」は「友」。"]]],["筆順(書く じゅんばん)","hitsujun",[["[近] で さいごに 書く ところ",["しんにょう(辶)","「斤」の ノ","「斤」の たての 線","「斤」の よこの 線"],"「辶(しんにょう)」は さいごに 書きます。"],["[道] で さいごに 書く ところ",["しんにょう(辶)","「首」の 上の てん","「目」の 部分","「首」の よこの 線"],"「道」も しんにょうは さいごです。"],["[国] で さいごに 書く 線",["いちばん 下の よこの 線(かこみを とじる)","「玉」の てん","左の たての 線","いちばん 上の よこの 線"],"かこむ 形の 字は、中を 書いてから さいごに とじます。"],["[方] の 1画目",["てん(丶)","よこの 線","ノ(ななめの 線)","「フ」の 形の 線"],"「方」は てん → よこ → フ → ノ の じゅんです。"],["[午] の 1画目",["ノ(ななめの 線)","よこの 線","たての 線","てん"],"「午」は ノ → よこ → よこ → たて です。"],["[外] の 1画目",["ノ(「夕」の ななめの 線)","「卜」の たての 線","てん","よこの 線"],"「外」は 左の「夕」から 書きます。"],["[回] の 3画目",["中の「口」の 左の たての 線","外の いちばん 下の よこの 線","外の 左の たての 線","中の「口」の 下の よこの 線"],"外の 2画を 書いたら、中の「口」を 書き、さいごに 外を とじます。"],["[内] の 3画目",["ノ(「人」の 左の 線)","外の 左の たての 線","「人」の 右の 線","外の 上と 右の 線"],"「内」は たて → 上と 右 → ノ → 右の 線 です。"],["[兄] の 1画目",["「口」の 左の たての 線","「儿」の ノ","「口」の 上の よこの 線","「儿」の まがる 線"],"「兄」は 上の「口」から 書きます。"],["[間] の 1画目",["「門」の 左の たての 線","「日」の たての 線","「日」の よこの 線","「門」の 右の 線"],"「間」は「門(もんがまえ)」から 書きます。"]]],["画数","kakusu",[["[曜]",["18画","17画","16画","19画"],"「曜」は 18画です。"],["[鳴]",["14画","13画","15画","12画"],"「鳴」は 14画です。「口」と「鳥」に 分けて 数えよう。"],["[顔]",["18画","17画","19画","16画"],"「顔」は 18画です。"],["[頭]",["16画","15画","17画","14画"],"「頭」は 16画です。"],["[歌]",["14画","13画","15画","12画"],"「歌」は 14画です。"],["[雲]",["12画","11画","13画","10画"],"「雲」は 12画です。"],["[電]",["13画","12画","14画","11画"],"「電」は 13画です。"],["[魚]",["11画","10画","12画","9画"],"「魚」は 11画です。"],["[馬]",["10画","9画","11画","8画"],"「馬」は 10画です。"],["[線]",["15画","14画","16画","13画"],"「線」は 15画です。"]]]]}